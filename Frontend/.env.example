# Logistimus frontend — environment template.
# Copy to Frontend/.env (or set in the CI/deploy environment). NEVER commit real values.
#
# IMPORTANT: only NEXT_PUBLIC_* variables exist, and Next.js inlines them
# at BUILD time. Set this before `npm run build`, not only at server start.

# Base URL of the backend API. Must match the backend's public origin + /api/v1.
# Local dev default (used when unset): http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
