# docker-compose.deploy.yml interpolation file (staging & production host).
#
# Copy this file to `.env` NEXT TO docker-compose.deploy.yml — Compose reads
# it automatically for ${VAR} substitution and refuses to start without the
# three REQUIRED values below. Git-ignored; never commit the real file.
#
# Django settings (SECRET_KEY, ALLOWED_HOSTS, CORS, SMTP, …) are NOT here —
# they live in Backend/.env (see Backend/.env.example). Passwords and the
# secret key exist only on the deployment host; CI never sees them.

# --- REQUIRED (compose fails fast without these) -------------------------

# PostgreSQL superuser password for the `db` service (in-network only).
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# MinIO root password (in-network only; S3 is internal).
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password

# Public API origin the frontend bundle is inlined against at BUILD time.
# Must be the exact origin the browser uses, ending in /api/v1.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# --- OPTIONAL (defaults shown) -------------------------------------------

# POSTGRES_DB=logistimus
# POSTGRES_USER=logistimus
# MINIO_ROOT_USER=logistimus
# S3_ENDPOINT_URL=http://minio:9000
