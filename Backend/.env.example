# Logistimus backend — environment template.
# Copy to Backend/.env and fill in real values. NEVER commit the real file.
# Every variable below is read by config/settings/*.py (verified Phase 2).
# Placeholders only — no real credentials in this file.

# --- Core -------------------------------------------------------------------
# development | production | test (informational label; the settings module
# selected by DJANGO_SETTINGS_MODULE is what actually changes behavior)
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.dev
# Reported app version (defaults to 0.1.0)
APP_VERSION=0.1.0
# MUST be False in staging/production (prod.py forces it regardless)
DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# In production prod.py refuses to boot with this placeholder.
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated exact origins. These also drive CSRF_TRUSTED_ORIGINS (https
# entries become CSRF-trusted), so every deployed frontend origin belongs here.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) ----------------------------------------
# Prod must be postgres:// — prod.py rejects sqlite.
DATABASE_URL=postgres://logistimus:logistimus-dev@localhost:5432/logistimus
# Postgres persistent-connection tuning (read in prod.py, default 60)
DB_CONN_MAX_AGE=60

# --- Redis (cache + Channels layer + Celery broker/results) -----------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (S3-compatible: AWS S3 in prod, MinIO locally) ----------
# Empty S3_ENDPOINT_URL falls back to local filesystem storage (dev only).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=logistimus
S3_REGION_NAME=us-east-1
S3_USE_SSL=True
# Lifetime of presigned download/upload URLs (seconds)
SIGNED_URL_TTL_SECONDS=600

# --- Auth / sessions --------------------------------------------------------
# Cookie path the HttpOnly refresh token is scoped to
REFRESH_COOKIE_PATH=/api/v1/auth/
# Pepper for device-key derived values — set a long random value in staging/prod
DEVICE_KEY_PEPPER=

# --- Email ------------------------------------------------------------------
# base.py default is the console backend — staging/production MUST set a real
# backend (e.g. django.core.mail.backends.smtp.EmailBackend) or mail is only logged.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Logistimus <no-reply@logistimus.example.com>
# SMTP connection (used only with the SMTP backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=30
# Absolute frontend base used in email links (reset/verify)
FRONTEND_URL=http://localhost:3000

# --- Django admin surface ---------------------------------------------------
# base default False; dev.py treats missing as True; prod.py default False.
ENABLE_ADMIN=False

# --- AI features (optional; empty provider disables) ------------------------
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_EXTERNAL_CONTEXT=False

# --- Production-only hardening ----------------------------------------------
# prod.py: SSL redirect (default True) and HSTS max-age (default 31536000)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Optional error tracking; empty disables Sentry init (prod.py)
SENTRY_DSN=

# --- Tests ------------------------------------------------------------------
# Used by config.settings/test.py; empty falls back to in-memory SQLite.
# CI sets this to the postgres service container.
DJANGO_TEST_DATABASE_URL=

# --- docker-compose variable interpolation (dev stack only) -----------------
POSTGRES_DB=logistimus
POSTGRES_USER=logistimus
POSTGRES_PASSWORD=logistimus-dev
MINIO_ROOT_USER=logistimus
MINIO_ROOT_PASSWORD=logistimus-dev
