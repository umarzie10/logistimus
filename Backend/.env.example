# Copy to .env and fill in real values. NEVER commit .env.

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostGIS) -----------------------------------------------------
DATABASE_URL=postgres://logistimus:logistimus-dev@localhost:5432/logistimus

# --- Redis (cache + channels + celery broker) -------------------------------
REDIS_URL=redis://localhost:6379/0
CHANNEL_LAYER_URL=redis://localhost:6379/1

# --- Object storage (MinIO / S3) --------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=logistimus
S3_SECRET_ACCESS_KEY=logistimus-dev
S3_BUCKET_NAME=logistimus
AWS_STORAGE_BUCKET_NAME=logistimus
AWS_S3_REGION_NAME=us-east-1

# --- Auth -------------------------------------------------------------------
SIMPLE_JWT_ACCESS_LIFETIME_MINUTES=15
SIMPLE_JWT_REFRESH_LIFETIME_DAYS=30

# --- Frontend (for absolute links in emails etc.) ---------------------------
FRONTEND_URL=http://localhost:3000
